# ==============================================================================
# LabGuard+ Environment Configuration
# Copy this file to `.env` for local runs, or edit `/etc/default/labguard`
# on Raspberry Pi and restart with `sudo systemctl restart labguard`.
# ==============================================================================

# TCP port the LabGuard+ server listens on (default: 5000)
PORT=5000

# Optional fixed public base URL embedded in Checkout, Return, and Student
# Registration QR codes. Leave blank to auto-detect the machine's active LAN IP.
# Examples:
#   APP_URL=http://labguard.local:5000
#   APP_URL=http://192.168.1.50:5000
APP_URL=

# ------------------------------------------------------------------------------
# Persistent Data Directory & SQLite Database
# ------------------------------------------------------------------------------
# Directory where LabGuard+ stores student School ID uploads (`<dir>/id_photos/`).
# Local default: . (current repository folder)
# Raspberry Pi installer default: /var/lib/labguard
LABGUARD_DATA_DIR=.

# SQLite database file path.
# Local default: ./labguard.db
# Raspberry Pi installer default: /var/lib/labguard/labguard.db
LABGUARD_DB_PATH=./labguard.db

# ------------------------------------------------------------------------------
# Laboratory Admin Credentials
# ------------------------------------------------------------------------------
# IMPORTANT: Change LABGUARD_ADMIN_PASSWORD before deploying in a school lab!
LABGUARD_ADMIN_EMAIL=lara.puertollano@arellano.edu.ph
LABGUARD_ADMIN_PASSWORD=au-jrc-2026
LABGUARD_ADMIN_NAME="Ms. Lara Marie A. Puertollano"

# ------------------------------------------------------------------------------
# Raspberry Pi GPIO Control (Pi 2B, Pi 3B/3B+, Pi 4B, Pi 5, Pi Zero 2 W)
# ------------------------------------------------------------------------------
# NOTE: All 12 Locker GPIO lock pins (default BCM 5,6,13,19,26,12,16,20,21,24,
#       25,4), relay polarity (Active-LOW / Active-HIGH), unlock pulse duration,
#       and the 3 Safety Status LEDs + Buzzer can be configured & tested LIVE
#       inside Admin (/admin) -> GPIO & Locker Hardware. Settings saved in the
#       Admin UI are persisted in SQLite and override the fallback defaults below.
#
# LABGUARD_GPIO_ENABLED:
#   auto = drive real GPIO on Raspberry Pi, simulate cleanly on PC/Mac (default)
#   1    = force GPIO enabled
#   0    = force simulation mode (disables physical GPIO pins)
LABGUARD_GPIO_ENABLED=auto

# Initial fallback Safety Status LED & Buzzer BCM GPIO pins (used before saving
# custom hardware settings inside /admin -> GPIO & Locker Hardware):
# Green LED (SAFE) — BCM GPIO 17 (Physical Pin 11)
LABGUARD_LED_GREEN_PIN=17

# Yellow LED (CAUTION) — BCM GPIO 27 (Physical Pin 13)
LABGUARD_LED_YELLOW_PIN=27

# Red LED (UNSAFE) — BCM GPIO 22 (Physical Pin 15)
LABGUARD_LED_RED_PIN=22

# Optional Active Buzzer — BCM GPIO 23 (Physical Pin 16); set to 0 or none to disable
LABGUARD_BUZZER_PIN=23
LABGUARD_BUZZER_ENABLED=1

# LED polarity: 1 = active-high (standard LEDs to GND), 0 = active-low (e.g. relay boards)
LABGUARD_LED_ACTIVE_HIGH=1
