# ==============================================================================
# LabGuard+ Environment Configuration
# Copy this file to `.env` for local runs, or edit `/etc/default/labguard`
# on Raspberry Pi and restart with `sudo systemctl restart labguard`.
# ==============================================================================

# TCP port the LabGuard+ server listens on (default: 5000)
PORT=5000

# Optional fixed public base URL embedded in Checkout QR codes.
# Leave blank to auto-detect the machine's active LAN IPv4 address.
# Examples:
#   APP_URL=http://labguard.local:5000
#   APP_URL=http://192.168.1.50:5000
APP_URL=

# SQLite database file path.
# Local default: ./labguard.db
# Raspberry Pi installer default: /var/lib/labguard/labguard.db
LABGUARD_DB_PATH=./labguard.db

# ------------------------------------------------------------------------------
# Raspberry Pi GPIO LED Safety Status Display & Optional Buzzer (BCM numbering)
# ------------------------------------------------------------------------------
# LABGUARD_GPIO_ENABLED:
#   auto = drive real GPIO on Raspberry Pi, simulate cleanly on PC/Mac (default)
#   1    = force GPIO enabled
#   0    = force simulation mode (disables physical GPIO pins)
LABGUARD_GPIO_ENABLED=auto

# Green LED (SAFE) — BCM GPIO 17 (Physical Pin 11)
LABGUARD_LED_GREEN_PIN=17

# Yellow LED (CAUTION) — BCM GPIO 27 (Physical Pin 13)
LABGUARD_LED_YELLOW_PIN=27

# Red LED (UNSAFE) — BCM GPIO 22 (Physical Pin 15)
LABGUARD_LED_RED_PIN=22

# Optional Active Buzzer — BCM GPIO 23 (Physical Pin 16); set to 0 or none to disable
LABGUARD_BUZZER_PIN=23
LABGUARD_BUZZER_ENABLED=1

# LED polarity: 1 = active-high (standard LEDs to GND), 0 = active-low (e.g. relay boards)
LABGUARD_LED_ACTIVE_HIGH=1
